# ==========================================
# Calibration Datasets & Image Artifacts
# ==========================================
# Ignore captured raw and preview frames
calibration_images/
*.png
*.jpg
*.jpeg
*.bmp
*.tiff
*.tif

# Ignore rendered printouts & reports
*.pdf

# Preserve essential visual assets if needed in docs (uncomment if applicable)
# !docs/**/*.png
# !docs/**/*.pdf

# ==========================================
# Python & Bytecode Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ==========================================
# IDE & Editor Configurations
# ==========================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store

# ==========================================
# Temporary Files & OS Artifacts
# ==========================================
/tmp/
*.tmp
*.log
.directory

# ==========================================
# Calibration Output (Optional Exception)
# ==========================================
# Keep generated YAML intrinsics tracked, ignore other raw dumps
!*.yaml
!*.yml

*.npy